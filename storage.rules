rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Avatares de usuarios: main.jpg (crop cuadrado) + original.{ext}
    match /avatars/{uid}/{filename} {
      allow read: if true;
      allow write: if request.auth != null &&
                   request.auth.uid == uid &&
                   request.resource.size < 5 * 1024 * 1024 &&
                   request.resource.contentType.matches('image/(jpeg|png|webp)');
    }

    // Imágenes de sala: card (main.jpg) + original (original.{ext})
    match /salas/{salaId}/{filename} {
      allow read: if true;
      allow write: if request.auth != null &&
                   request.resource.size < 10 * 1024 * 1024 &&
                   request.resource.contentType.matches('image/(jpeg|png|webp)');
    }

    // Fotos de partidas (subidas por jugadores)
    match /fotosPartidas/{partidaId}/{usuarioId}/{fotoId} {
      allow read: if true;
      allow write: if request.auth != null &&
                   request.auth.uid == usuarioId &&
                   request.resource.size < 10 * 1024 * 1024 &&
                   request.resource.contentType.matches('image/(jpeg|png)');
      allow delete: if request.auth != null && request.auth.uid == usuarioId;
    }

    // Imagen principal de ruta
    match /rutas/{rutaId}/main.jpg {
      allow read: if true;
      allow write: if request.auth != null &&
                   request.resource.size < 5 * 1024 * 1024 &&
                   request.resource.contentType.matches('image/(jpeg|png)');
    }
  }
}
